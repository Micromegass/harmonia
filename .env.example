# Copy to .env for local dev; set the same vars in Vercel → Project → Settings → Environment Variables.

# WhatsApp number for the floating button and contact fallbacks.
# Digits only, country code first, no "+" (Colombia = 57). Example: 573001234567
# TODO: replace with the studio's real WhatsApp number.
VITE_WHATSAPP_NUMBER=573001234567

# Web3Forms access key for the contact form (free: https://web3forms.com — create with the studio's email).
# This key is designed to be public/client-side, but keep it in env so it can be rotated without a code change.
# Until set, the form UI falls back to WhatsApp + mailto.
VITE_WEB3FORMS_KEY=

# Public email shown as contact fallback and in legal pages (data-rights channel).
# TODO: replace with the studio's real email.
VITE_CONTACT_EMAIL=hola@harmoniabaila.example

# Canonical production origin, used for SEO tags and sitemap generation.
VITE_SITE_ORIGIN=https://harmonia-baila.vercel.app
